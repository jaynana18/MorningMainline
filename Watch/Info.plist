<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>3</string>
    <key>CFBundleDisplayName</key>
    <string>不跑偏</string>
    <!-- 手表上做一句话创建时需要取得「出发地」，用于搜索附近的目的地并计算通勤时间。
         与 iOS 侧 `iOS/Info.plist` 的 NSLocationWhenInUseUsageDescription 同因同文案。
         缺这一项时 CLLocationManager 不会弹授权、直接失败，表现为「一句话创建总是按名称搜」。 -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>用于搜索附近的目的地并计算任务之间的通勤时间。</string>
    <key>WKApplication</key>
    <true/>
    <key>WKCompanionAppBundleIdentifier</key>
    <string>com.jaynana.MorningMainline</string>
    <key>WKRunsIndependentlyOfCompanionApp</key>
    <true/>
</dict>
</plist>
